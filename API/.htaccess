# Nivasity Mobile API - Access Control

# Enable mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Rewrite setup and verification requests to the redirect handler
    RewriteRule ^setup\.html$ setup_redirect.php [QSA,L]
    RewriteRule ^setup_org\.html$ setup_redirect.php?type=org [QSA,L]
    RewriteRule ^verify\.html$ setup_redirect.php?type=visitor [QSA,L]
</IfModule>

# Security Headers
# NOTE: CORS headers are handled dynamically in config.php to support
# Access-Control-Allow-Credentials for .nivasity.com SSO cookies.
<IfModule mod_headers.c>
    # Security headers only (CORS is set in PHP, not here)
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# OPTIONS preflight is handled by PHP (config.php sets CORS headers before exit)
# Do NOT intercept OPTIONS here — it would return 200 without CORS headers.

# Deny access to sensitive files
<FilesMatch "^(config|auth)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP Settings
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>

# Enable error logging (disable display_errors in production)
php_flag display_errors Off
php_flag log_errors On

# Directory browsing
Options -Indexes

# Default character set
AddDefaultCharset UTF-8
